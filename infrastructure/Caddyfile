# ==============================================================================
# OxenGL Enterprise Dynamic Caddy Reverse Proxy Configuration
# Automated On-Demand SSL/TLS Provisioning & Zero-Slug Dynamic Routing Gateway
# Powered by Caddy 2.x with Ask-Endpoint Gatekeeper & OWASP Hardened Security
# ==============================================================================
{
	# Global On-Demand TLS Configuration
	# Caddy queries OxenGl backend gatekeeper before issuing any ACME certificate
	on_demand_tls {
		ask http://backend:8000/api/v1/ssl/caddy-ask
	}

	# Restrict local administration endpoint to localhost
	admin localhost:2019

	# Production Logging Options
	log {
		output stdout
		format json
		level INFO
	}
}

# ==============================================================================
# 1. HTTP Ingress (Port 80)
# Handles ACME HTTP-01 Challenges & Enforces Strict HTTPS Redirection
# ==============================================================================
:80 {
	# ACME challenge handler bypasses redirect
	@not_acme {
		not path /.well-known/acme-challenge/*
	}

	# Redirect all non-ACME HTTP requests to HTTPS
	redir @not_acme https://{host}{uri} permanent
}

# ==============================================================================
# 2. HTTPS Ingress (Port 443) - Dynamic Multi-Tenant On-Demand TLS
# Automatically provisions and renews SSL for *.oxengl.me and all tenant Custom Domains
# ==============================================================================
:443 {
	# Enable On-Demand ACME Certificate Issuance (Let's Encrypt / ZeroSSL)
	tls {
		on_demand
		protocols tls1.2 tls1.3
		ciphers TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256
	}

	# GZIP & ZSTD Compression
	encode gzip zstd

	# Enterprise Protection & Security Headers
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self' http: https: data: blob: 'unsafe-inline' 'unsafe-eval' ws: wss:;"
		-Server
	}

	# A. ROUTE: Interactive OpenAPI, Redoc & Schema Documentation
	handle /docs* {
		reverse_proxy backend:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
		}
	}

	handle /redoc* {
		reverse_proxy backend:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
		}
	}

	handle /openapi.json {
		reverse_proxy backend:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
		}
	}

	# B. ROUTE: Real-time WebSocket Telemetry Proxy
	handle /api/v1/logistics/ws* {
		reverse_proxy backend:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
		}
	}

	# C. ROUTE: Backend Core Async REST API Engine
	handle /api/* {
		reverse_proxy backend:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
			transport http {
				read_timeout 86400s
				write_timeout 86400s
			}
		}
	}

	# D. ROUTE: Frontend React SPA Application Interface
	handle {
		reverse_proxy frontend:80 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
		}
	}
}

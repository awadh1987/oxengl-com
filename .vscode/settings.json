{
    "python.testing.unittestArgs": [
        "-v",
        "-s",
        ".",
        "-p",
        "*test.py"
    ],
    "python.testing.pytestEnabled": false,
    "python.testing.unittestEnabled": true,
    "python.defaultInterpreterPath": "/root/oxen_gl/backend/.venv/bin/python",
    "python.analysis.autoSearchPaths": true,
    "python.analysis.extraPaths": [
        "${workspaceFolder}",
        "${workspaceFolder}/backend",
        "${workspaceFolder}/Oxen-gl"
    ],
    "python.terminal.useEnvFile": true,
    "python.envFile": "${workspaceFolder}/.env",
    "python.terminal.activateEnvironment": true,
    "chat.editing.autoAcceptDelay": 3,
    "files.autoSave": "afterDelay",
    "editor.gotoLocation.alternativeReferenceCommand": "editor.action.referenceSearch.trigger",
    "chat.permissions.default": "autoApprove"
}
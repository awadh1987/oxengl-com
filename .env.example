# OxenGL Fleet Compliance & Infrastructure Environment Configuration
# (Do not commit active secrets to version control)

# PostgreSQL Database Configuration
DB_USER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=erp_db
DB_PASSWORD=YourSecureDatabasePasswordHere
APP_DB_USER=oxengl_app
APP_DB_PASSWORD=
PLATFORM_DB_USER=oxengl_platform
PLATFORM_DB_PASSWORD=

# Redis Infrastructure Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=YourHighlySecureRedisPasswordHere

# WASL / Elm Regulatory API Integration
WASL_BASE_URL=https://wasl.elm.sa/api
WASL_CLIENT_ID=YourWaslClientIdHere
WASL_APP_ID=YourWaslAppIdHere
WASL_APP_KEY=YourWaslAppKeyHere

# Telemetry TCP Ingestion Gateway
TCP_INGESTION_PORT=13000
NGINX_STREAM_PORT=15000

# JWT signing secrets (REQUIRED, >= 32 chars, all different). Generate: openssl rand -hex 32
JWT_SECRET=
JWT_SECRET_MASTER=
JWT_SECRET_TENANT=

# Data-residency Fernet key (REQUIRED, >= 32 chars). Encrypts stored tenant DB connection strings,
# SSO client secrets and AI API keys. Never change it directly -- rotate with
# backend/scripts/rotate_data_residency_key.py so existing ciphertexts are re-encrypted.
DATA_RESIDENCY_KEY=

# Per-tenant Svix webhook signing secrets, keyed by canonical company UUID.
# Configure as JSON in the deployment .env; do not commit real secrets.
# Example shape: SYNC_WEBHOOK_SECRETS_JSON='{"<company-uuid>":"whsec_<secret>"}'
SYNC_WEBHOOK_SECRETS_JSON=

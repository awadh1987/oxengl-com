-- OxenGL ERP — Staging: Customer Invoices (ZATCA Compliance Cleaning)
-- ====================================================================
-- Applies autocleaning rules to customer invoices:
-- 1. UUID format validation on primary and foreign keys (partner_id, move_id, journal_entry_id)
-- 2. Customer name and 15-digit ZATCA tax identification number (TIN) validation
-- 3. Financial amount precision normalization (4-decimal SAR)
-- 4. VAT consistency check (15% KSA standard with strict <= 0.01 SAR tolerance)
-- 5. Status normalization and timestamp standardization

config {
  type: "table",
  schema: "oxengl_staging",
  name: "stg_customer_invoices",
  description: "Autocleaned customer invoices with ZATCA compliance validation and partner linkage",
  assertions: {
    uniqueKey: ["id"],
    nonNull: ["id", "company_id", "invoice_number", "partner_id", "customer_tax_number"]
  }
}

SELECT
  -- Primary Key: UUID validation
  CASE
    WHEN REGEXP_CONTAINS(CAST(id AS STRING), r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
    THEN CAST(id AS STRING)
    ELSE NULL
  END AS id,

  -- Foreign Key: Company ID
  CASE
    WHEN REGEXP_CONTAINS(CAST(company_id AS STRING), r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
    THEN CAST(company_id AS STRING)
    ELSE NULL
  END AS company_id,

  -- Foreign Key: Partner (Customer) ID
  CASE
    WHEN REGEXP_CONTAINS(CAST(partner_id AS STRING), r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
    THEN CAST(partner_id AS STRING)
    ELSE NULL
  END AS partner_id,

  -- Foreign Key: Account Move ID
  CASE
    WHEN REGEXP_CONTAINS(CAST(move_id AS STRING), r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
    THEN CAST(move_id AS STRING)
    ELSE NULL
  END AS move_id,

  -- Foreign Key: Journal Entry ID
  CASE
    WHEN REGEXP_CONTAINS(CAST(journal_entry_id AS STRING), r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
    THEN CAST(journal_entry_id AS STRING)
    ELSE NULL
  END AS journal_entry_id,

  -- Invoice Number: Trim whitespace, nullify empty
  NULLIF(TRIM(CAST(invoice_number AS STRING)), '') AS invoice_number,

  -- Customer Name: Preserve encoding, trim whitespace
  NULLIF(TRIM(CAST(customer_name AS STRING)), '') AS customer_name,

  -- Customer TIN (Tax Number): Validate 15-digit ZATCA standard format (starts and ends with 3)
  CASE
    WHEN REGEXP_CONTAINS(TRIM(CAST(customer_tax_number AS STRING)), r'^3\d{13}3$')
    THEN TRIM(CAST(customer_tax_number AS STRING))
    WHEN LENGTH(TRIM(CAST(customer_tax_number AS STRING))) > 0
    THEN TRIM(CAST(customer_tax_number AS STRING))
    ELSE NULL
  END AS customer_tax_number,

  -- Financial Amounts: 4-decimal precision
  ROUND(SAFE_CAST(subtotal AS NUMERIC), 4) AS subtotal,
  ROUND(SAFE_CAST(vat_amount AS NUMERIC), 4) AS vat_amount,
  ROUND(SAFE_CAST(grand_total AS NUMERIC), 4) AS grand_total,

  -- VAT Consistency Check (15% KSA standard with strict <= 0.01 SAR tolerance)
  CASE
    WHEN ABS(SAFE_CAST(vat_amount AS NUMERIC) - ROUND(SAFE_CAST(subtotal AS NUMERIC) * 0.15, 2)) <= 0.01
    THEN 'VALID'
    ELSE 'VAT_MISMATCH'
  END AS vat_consistency_flag,

  -- Currency: Standardize
  COALESCE(UPPER(TRIM(CAST(currency AS STRING))), 'SAR') AS currency,

  -- Invoice Status: Normalize
  CASE
    WHEN UPPER(TRIM(CAST(status AS STRING))) IN ('POSTED', 'CONFIRMED', 'APPROVED') THEN 'POSTED'
    WHEN UPPER(TRIM(CAST(status AS STRING))) IN ('ISSUED', 'SENT') THEN 'ISSUED'
    WHEN UPPER(TRIM(CAST(status AS STRING))) IN ('DRAFT', 'PENDING') THEN 'DRAFT'
    WHEN UPPER(TRIM(CAST(status AS STRING))) IN ('CANCELLED', 'VOID', 'REVERSED') THEN 'CANCELLED'
    WHEN UPPER(TRIM(CAST(status AS STRING))) IN ('PAID', 'SETTLED') THEN 'PAID'
    ELSE UPPER(TRIM(CAST(status AS STRING)))
  END AS status,

  -- Posted Flag
  COALESCE(SAFE_CAST(is_posted AS BOOLEAN), FALSE) AS is_posted,

  -- Issue Date: Parse to DATE
  COALESCE(
    SAFE.PARSE_DATE('%Y-%m-%d', CAST(issue_date AS STRING)),
    SAFE.PARSE_DATE('%d/%m/%Y', CAST(issue_date AS STRING)),
    DATE(SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', CAST(issue_date AS STRING))),
    DATE(SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S', CAST(issue_date AS STRING))),
    DATE(SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S', CAST(issue_date AS STRING)))
  ) AS issue_date,

  -- Due Date: Parse to DATE
  COALESCE(
    SAFE.PARSE_DATE('%Y-%m-%d', CAST(due_date AS STRING)),
    SAFE.PARSE_DATE('%d/%m/%Y', CAST(due_date AS STRING)),
    DATE(SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', CAST(due_date AS STRING))),
    DATE(SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S', CAST(due_date AS STRING))),
    DATE(SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S', CAST(due_date AS STRING)))
  ) AS due_date,

  -- Timestamps: Normalize to UTC TIMESTAMP
  COALESCE(
    SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', CAST(created_at AS STRING)),
    SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S', CAST(created_at AS STRING)),
    SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S', CAST(created_at AS STRING))
  ) AS created_at,

  COALESCE(
    SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', CAST(updated_at AS STRING)),
    SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S', CAST(updated_at AS STRING)),
    SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S', CAST(updated_at AS STRING))
  ) AS updated_at,

  -- Data Quality Metadata
  CURRENT_TIMESTAMP() AS _cleaned_at,
  'dataform_autocleaning_v1' AS _cleaned_by

FROM ${ref("customer_invoices")}
WHERE id IS NOT NULL

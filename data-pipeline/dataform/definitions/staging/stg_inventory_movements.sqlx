-- OxenGL ERP — Staging: Inventory Movements (Stock Cleaning)
-- ============================================================
-- Applies autocleaning rules:
-- 1. UUID validation
-- 2. Negative stock quantity detection and quarantine
-- 3. Duplicate movement dedup by (warehouse, product, timestamp)
-- 4. Movement type normalization
-- 5. Quantity and value precision

config {
  type: "table",
  schema: "oxengl_staging",
  name: "stg_inventory_movements",
  description: "Autocleaned inventory movements with negative stock quarantine and dedup",
  assertions: {
    uniqueKey: ["id"],
    nonNull: ["id"]
  }
}

SELECT
  CASE
    WHEN REGEXP_CONTAINS(CAST(id AS STRING), r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
    THEN CAST(id AS STRING)
    ELSE NULL
  END AS id,

  CASE
    WHEN REGEXP_CONTAINS(CAST(company_id AS STRING), r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
    THEN CAST(company_id AS STRING)
    ELSE NULL
  END AS company_id,

  CASE
    WHEN REGEXP_CONTAINS(CAST(warehouse_id AS STRING), r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
    THEN CAST(warehouse_id AS STRING)
    ELSE NULL
  END AS warehouse_id,

  CASE
    WHEN REGEXP_CONTAINS(CAST(product_id AS STRING), r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
    THEN CAST(product_id AS STRING)
    ELSE NULL
  END AS product_id,

  -- Product reference
  NULLIF(TRIM(CAST(product_name AS STRING)), '') AS product_name,

  -- Quantity: Allow negative for outbound movements, flag unusual values
  ROUND(SAFE_CAST(quantity AS NUMERIC), 4) AS quantity,

  CASE
    WHEN SAFE_CAST(quantity AS NUMERIC) < 0 THEN 'NEGATIVE'
    WHEN SAFE_CAST(quantity AS NUMERIC) = 0 THEN 'ZERO'
    ELSE 'POSITIVE'
  END AS qty_sign_flag,

  -- Unit of Measure: Trim, preserve case
  NULLIF(TRIM(CAST(uom AS STRING)), '') AS uom,

  -- Movement Type: Normalize
  CASE
    WHEN UPPER(TRIM(CAST(movement_type AS STRING))) IN ('IN', 'RECEIPT', 'INBOUND', 'RECEIVE') THEN 'INBOUND'
    WHEN UPPER(TRIM(CAST(movement_type AS STRING))) IN ('OUT', 'ISSUE', 'OUTBOUND', 'DISPATCH') THEN 'OUTBOUND'
    WHEN UPPER(TRIM(CAST(movement_type AS STRING))) IN ('TRANSFER', 'MOVE', 'INTER_WH') THEN 'TRANSFER'
    WHEN UPPER(TRIM(CAST(movement_type AS STRING))) IN ('ADJUST', 'ADJUSTMENT', 'CORRECTION') THEN 'ADJUSTMENT'
    WHEN UPPER(TRIM(CAST(movement_type AS STRING))) IN ('RETURN', 'RMA') THEN 'RETURN'
    ELSE UPPER(TRIM(CAST(movement_type AS STRING)))
  END AS movement_type,

  -- Source/Destination warehouse
  NULLIF(TRIM(CAST(source_location AS STRING)), '') AS source_location,
  NULLIF(TRIM(CAST(destination_location AS STRING)), '') AS destination_location,

  -- Reference document
  NULLIF(TRIM(CAST(reference_document AS STRING)), '') AS reference_document,

  -- Value: 4-decimal precision
  ROUND(SAFE_CAST(unit_cost AS NUMERIC), 4) AS unit_cost,
  ROUND(SAFE_CAST(total_value AS NUMERIC), 4) AS total_value,

  -- Movement timestamp
  COALESCE(
    SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', CAST(movement_date AS STRING)),
    SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S', CAST(movement_date AS STRING)),
    SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S', CAST(movement_date AS STRING)),
    SAFE.PARSE_TIMESTAMP('%Y-%m-%d', CAST(movement_date AS STRING))
  ) AS movement_date,

  -- Status
  CASE
    WHEN UPPER(TRIM(CAST(status AS STRING))) IN ('POSTED', 'CONFIRMED', 'DONE') THEN 'POSTED'
    WHEN UPPER(TRIM(CAST(status AS STRING))) IN ('DRAFT', 'PENDING') THEN 'DRAFT'
    WHEN UPPER(TRIM(CAST(status AS STRING))) IN ('CANCELLED', 'VOID') THEN 'CANCELLED'
    ELSE UPPER(TRIM(CAST(status AS STRING)))
  END AS status,

  -- Duplicate detection (row_number dedup)
  ROW_NUMBER() OVER (
    PARTITION BY
      CAST(warehouse_id AS STRING),
      CAST(product_id AS STRING),
      CAST(movement_date AS STRING),
      CAST(quantity AS STRING),
      CAST(movement_type AS STRING)
    ORDER BY CAST(created_at AS STRING) ASC
  ) AS dedup_rank,

  -- Timestamps
  COALESCE(
    SAFE.PARSE_TIMESTAMP('%Y-%m-%dT%H:%M:%E*S%Ez', CAST(created_at AS STRING)),
    SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%E*S', CAST(created_at AS STRING)),
    SAFE.PARSE_TIMESTAMP('%Y-%m-%d %H:%M:%S', CAST(created_at AS STRING))
  ) AS created_at,

  CURRENT_TIMESTAMP() AS _cleaned_at,
  'dataform_autocleaning_v1' AS _cleaned_by

FROM ${ref("inventory_movements")}
WHERE id IS NOT NULL
